# ==============================================================================
# LynxWAF Community Edition - Git Ignore Rules
# ==============================================================================

# Runtime secrets & environment configuration
.env
.env.local
.env.*.local

# Persistent runtime data and databases
data/
data/mysql/
data/nginx/
data/wwwroot/

# Runtime log directories
logs/
*.log

# Sensitive SSL/TLS certificates & custom keys
ssl/
*.pem
*.key
*.crt
*.csr
*.lic

# Temporary and packaging artifacts
*.tar.gz
*.tar
*.zip
dist/
tmp/
temp/

# Updater snapshots: pre-update backups and stack-file copies kept before overwrite
backups/
*.bak
*.bak.*
docker-compose.yml.upstream

# OS and Editor metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*~
