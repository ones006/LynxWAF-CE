# ==============================================================================
# LynxWAF Community Edition — Environment Configuration Template
# Repository: https://github.com/ones006/LynxWAF-CE
# ==============================================================================

# Management Console Port & IP Binding
# Access the web console at https://<SERVER_IP>:${LYNXWAF_PORT}
LYNXWAF_PORT=8379
LYNXWAF_BIND_IP=0.0.0.0

# Deployment Environment (production / development)
LYNXWAF_ENV=production

# Container Image Registry & Tags
# Official multi-arch images (linux/amd64 & linux/arm64) hosted on GitHub Container Registry
LYNXWAF_DAEMON_IMAGE=ghcr.io/ones006/lynxwaf-daemon:ce-latest
LYNXWAF_OPENRESTY_IMAGE=ghcr.io/ones006/lynxwaf-openresty:ce-latest

# Cryptographic Secrets & Database Credentials
# These carry no defaults on purpose: docker-compose refuses to start while any of
# them is empty, so a copy of this file can never boot a host on a published
# password. Generate them before the first run —
#   MYSQL_ROOT_PASSWORD=$(openssl rand -base64 32)
#   REDIS_PASSWORD=$(openssl rand -base64 32)
#   INITIAL_ADMIN_PASSWORD=$(openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | cut -c1-16)
# install.sh does all three and writes .env with mode 0600.
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
INITIAL_ADMIN_PASSWORD=

# Security Entrance (secret URL path for the Web Console, min 8 alphanumeric chars)
# Leave empty and install.sh generates a random one; set it only when you are
# standing the stack up by hand.
SECURITY_ENTRANCE=

# Version Tag
LYNXWAF_VERSION=ce-latest

# Install Counter (installer only; off by default)
#   LYNXWAF_INSTALL_TELEMETRY=on
#                        lets install.sh send one anonymous ping — the host
#                        architecture and nothing else — so the CE deployment
#                        count is not guessed. Off means the installer contacts
#                        no counter endpoint at all.
LYNXWAF_INSTALL_TELEMETRY=

# ==============================================================================
# Outbound Traffic — every switch below is off until you ask for it
# ==============================================================================
# A fresh CE container volunteers nothing. Uncomment only what you want.
#
#   LYNXWAF_LICENSE_ACTIVATION=online
#                                 apply a licence by also registering it with the
#                                 activation portal (sends licence id, customer,
#                                 machine hash, hostname and node IP). Off by
#                                 default: the signed licence and its machine
#                                 binding are verified locally.
#   LYNXWAF_LICENSE_HEARTBEAT=on  weekly licence presence ping to the activation
#                                 portal; a licence that cannot reach it stays
#                                 valid, so air-gapped hosts need nothing here.
#   LYNXWAF_MONTHLY_REPORT=on     mail the closed month's compliance PDF to each
#                                 active tenant's contact address (or to the
#                                 configured notification receivers). Requires
#                                 the email channel under Notifications.
#   LYNXWAF_SERVER_IP=203.0.113.7
#                                 declare the address the console, its certificate
#                                 SANs and the attack map use, with no lookup and
#                                 no request at all. Inside a container the egress
#                                 interface is the bridge network, so a host
#                                 reached through published ports should set this.
#   LYNXWAF_PUBLIC_IP_DETECTION=on
#                                 ask a public address echo service what address
#                                 this host is reached at. Off by default.
LYNXWAF_LICENSE_ACTIVATION=
LYNXWAF_LICENSE_HEARTBEAT=
LYNXWAF_MONTHLY_REPORT=
LYNXWAF_SERVER_IP=
LYNXWAF_PUBLIC_IP_DETECTION=

# Vulnerability Feed (off until asked; the built-in catalog keeps working)
#   LYNXWAF_VULN_FEED_URL   https location of a signed catalog document. The .sig
#                           sibling is fetched alongside and must verify, otherwise
#                           nothing is written. Several regions may be listed
#                           comma-separated; they are tried in that order.
#   LYNXWAF_CATALOG_PUBKEY  Ed25519 public key (base64, 32 bytes) replacing the key
#                           built into the binary.
#   LYNXWAF_CATALOG_PUBKEYS comma-separated extra keys, used while rotating the
#                           feed signing key.
# Air-gapped hosts need none of these: drop config/vuln_catalog.json plus its .sig
# into the mounted ./config volume and sync from the console, or leave both absent
# and the embedded catalog is used. The signing key is never read from this file.
LYNXWAF_VULN_FEED_URL=
LYNXWAF_CATALOG_PUBKEY=
LYNXWAF_CATALOG_PUBKEYS=

# Content Feeds (off until asked; whatever this host holds keeps working)
#   LYNXWAF_FEED_URL     location of the signed feed manifest (feed_manifest.json).
#                        It names the CRS rule snapshot, the threat-intel blocklists
#                        and the GeoIP database, each with a SHA-256 digest. Nothing
#                        is downloaded that does not match.
#   LYNXWAF_FEED_PUBKEY  Ed25519 public key (base64, 32 bytes) replacing the content
#                        feed key built into the binary.
#   LYNXWAF_FEED_PUBKEYS comma-separated extra keys, used while rotating the feed
#                        signing key.
# With all three empty, the CRS snapshot and blocklists are read from disk and the
# blocklists come straight from the named upstream publishers (Tor Project bulk
# exit list, Spamhaus DROP). The feed signing key is never read from this file.
#
#   LYNXWAF_THREAT_INTEL_SYNC=off
#                        the one request that runs unconfigured: the nightly GET
#                        to those two public publishers. It is an unauthenticated
#                        GET that carries no licence ID, hostname or customer data,
#                        and the answer is a list of address ranges. Set it to off
#                        and the schedule skips the fetch entirely — the addresses
#                        already stored keep their expiry clock, so the blocklist
#                        decays instead of being emptied. Ignored when
#                        LYNXWAF_FEED_URL is set: the signed manifest is then the
#                        source.
LYNXWAF_FEED_URL=
LYNXWAF_FEED_PUBKEY=
LYNXWAF_FEED_PUBKEYS=
LYNXWAF_THREAT_INTEL_SYNC=

# Release Updates (off until asked; the built-in release key keeps working)
#   LYNXWAF_UPDATE_URL       location of the signed release manifest. Setting it is
#                            the only way this host learns a newer release exists.
#   LYNXWAF_RELEASE_PUBKEY   Ed25519 public key (base64, 32 bytes) replacing the
#                            release key built into the binary, when you publish
#                            releases yourself.
#   LYNXWAF_RELEASE_PUBKEYS  comma-separated extra keys, used while rotating the
#                            release signing key.
#   LYNXWAF_UPDATE_TELEMETRY on = post the outcome of a finished update (success,
#                            failure or rollback) to the endpoint the release came
#                            from. Off means an update never reports anything.
# A container never installs anything over its own image: the console states which
# step it can do here, and the verified bundle lands in ./data/update/staged for
# update_lynxwaf.sh --from-bundle to apply on the host. To move to a newer release,
# pull the image (docker compose pull && docker compose up -d).
LYNXWAF_UPDATE_URL=
LYNXWAF_RELEASE_PUBKEY=
LYNXWAF_RELEASE_PUBKEYS=
LYNXWAF_UPDATE_TELEMETRY=

# Monitoring
#   LYNXWAF_METRICS_TOKEN  bearer token required by GET /metrics. With it empty,
#                          /metrics answers only a loopback scraper; with it set, a
#                          scrape must send "Authorization: Bearer <token>".
#   LYNXWAF_METRICS_TOKEN=$(openssl rand -hex 24)
LYNXWAF_METRICS_TOKEN=

# Signed compliance reports
# Every issued PDF is signed by a key that belongs to this installation. Leave both
# values empty and the key is generated on first use at config/report_signing.key
# (inside the mounted ./config volume, mode 0600) and never leaves the host. An MSP
# that wants one verifiable authority across a fleet supplies the seed instead:
#   LYNXWAF_REPORT_SIGNING_KEY       ed25519 seed or private key, base64 (32/64 bytes)
#   LYNXWAF_REPORT_SIGNING_KEY_FILE  path to a mounted key file; wins over the default
LYNXWAF_REPORT_SIGNING_KEY=
LYNXWAF_REPORT_SIGNING_KEY_FILE=
