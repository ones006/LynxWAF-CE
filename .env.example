# ==============================================================================
# LynxWAF Community Edition — Environment Configuration Template
# Repository: https://github.com/ones006/LynxWAF-CE
# ==============================================================================

# Management Console Port & IP Binding
# Access the web console at https://<SERVER_IP>:${LYNXWAF_PORT}
LYNXWAF_PORT=8379
LYNXWAF_BIND_IP=0.0.0.0

# Deployment Environment (production / development)
LYNXWAF_ENV=production

# Container Image Registry & Tags
# Official multi-arch images (linux/amd64 & linux/arm64) hosted on GitHub Container Registry
LYNXWAF_DAEMON_IMAGE=ghcr.io/ones006/lynxwaf-daemon:ce-latest
LYNXWAF_OPENRESTY_IMAGE=ghcr.io/ones006/lynxwaf-openresty:ce-latest

# Cryptographic Secrets & Database Credentials
# IMPORTANT: In production, generate strong random strings for these passwords!
# (The install.sh script generates random 24-character secrets automatically)
MYSQL_ROOT_PASSWORD=lynxwaf_vault_secure_pwd_2026
REDIS_PASSWORD=lynxwaf_cluster_secret_2026

# Initial Administrative Credentials (used only on first container startup)
INITIAL_ADMIN_PASSWORD=lynxwaf_admin_sec_2026

# Security Entrance (secret URL path for Web Console, min 8 alphanumeric chars)
SECURITY_ENTRANCE=lynxentrance

# Version Tag
LYNXWAF_VERSION=ce-latest
